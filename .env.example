# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the Nuvho Knowledge Base database
DATABASE_URL=postgresql://nuvho_kb_user:password@host:5432/nuvho_kb

# Signs the admin session JWT (lib/auth.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Falls back to an insecure dev default if unset — always set this in production.
JWT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Enables embedding + vector ingestion from the admin dashboard.
OPENAI_API_KEY=

# Per-tier vector DB connection strings. Leave blank to disable that tier.
VECTOR_DB_DOMAIN_URL=
VECTOR_DB_INTERNAL_URL=
VECTOR_DB_CLIENT_URL=
VECTOR_DB_CONFIDENTIAL_URL=

# ── Uploads (article editor images) — lib/uploads.ts ──────────────────────────
# Maximum image size in MB (default 10).
MAX_UPLOAD_MB=10

# Where uploaded images are stored.
#   db     (default) rows in nuvho_kb.uploads in the main database, served at
#          /uploads/<id>.<ext>. Required on App Platform, which has no persistent disk.
#          Run scripts/005_uploads.sql once before the first upload.
#   local  files under UPLOADS_DIR (./uploads in dev, the /app/uploads volume in Docker),
#          served at /uploads/<yyyy>/<mm>/<file>. For a plain Docker host only.
UPLOAD_STORAGE=db
UPLOADS_DIR=
