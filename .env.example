# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the Nuvho Knowledge Base database
DATABASE_URL=postgresql://nuvho_kb_user:password@host:5432/nuvho_kb

# Signs the admin session JWT (lib/auth.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Falls back to an insecure dev default if unset — always set this in production.
JWT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Enables embedding + vector ingestion from the admin dashboard.
OPENAI_API_KEY=

# Per-tier vector DB connection strings. Leave blank to disable that tier.
VECTOR_DB_DOMAIN_URL=
VECTOR_DB_INTERNAL_URL=
VECTOR_DB_CLIENT_URL=
VECTOR_DB_CONFIDENTIAL_URL=

# ── Uploads (article editor images) ───────────────────────────────────────────
# On-disk root for images uploaded through the article editor; served at /uploads/….
# Docker sets /app/uploads (a named volume, see docker-compose.yml). Local dev defaults
# to ./uploads (gitignored). Leave blank to use the default.
UPLOADS_DIR=
# Maximum image size in MB (default 10). nginx client_max_body_size must be at least this.
MAX_UPLOAD_MB=10
