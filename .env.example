# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the Nuvho Knowledge Base database
DATABASE_URL=postgresql://nuvho_kb_user:password@host:5432/nuvho_kb

# Signs the admin session JWT (lib/auth.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Falls back to an insecure dev default if unset — always set this in production.
JWT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Enables embedding + vector ingestion from the admin dashboard.
OPENAI_API_KEY=

# Per-tier vector DB connection strings. Leave blank to disable that tier.
VECTOR_DB_DOMAIN_URL=
VECTOR_DB_INTERNAL_URL=
VECTOR_DB_CLIENT_URL=
VECTOR_DB_CONFIDENTIAL_URL=

# ── Uploads (article editor images) — lib/uploads.ts ──────────────────────────
# Maximum image size in MB (default 10).
MAX_UPLOAD_MB=10

# Backend A — DigitalOcean Spaces (REQUIRED in production on App Platform, which has no
# persistent disk). Used automatically when BUCKET, KEY and SECRET are all set.
# Create the Space with CDN enabled, then a Spaces access key (API → Spaces Keys).
SPACES_BUCKET=
SPACES_REGION=syd1
SPACES_KEY=
SPACES_SECRET=
# Public base URL for uploaded objects — the Space's CDN endpoint or custom subdomain.
# Falls back to https://<bucket>.<region>.digitaloceanspaces.com when blank.
SPACES_CDN_URL=
# Object key prefix inside the bucket (default: uploads)
SPACES_PREFIX=uploads

# Backend B — local disk, used when the Spaces variables are blank. Local dev default is
# ./uploads (gitignored); the Docker image sets /app/uploads on a named volume. Files are
# served by the app at /uploads/….
UPLOADS_DIR=
